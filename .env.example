# NEXORA Environment Configuration Template
# Brand: NEXORA | Automate Beyond Limits.
# Copy this file to .env before starting the development environment.
# Never commit .env or sensitive secrets to source control.

NODE_ENV=development

# -----------------------------------------------------------------------------
# NestJS Backend API
# -----------------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Next.js Web Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# PostgreSQL Database (Prisma)
# -----------------------------------------------------------------------------
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password
POSTGRES_DB=nexora
POSTGRES_PORT=5433
DATABASE_URL="postgresql://nexora:nexora_dev_password@localhost:5433/nexora?schema=public"

# -----------------------------------------------------------------------------
# Redis (BullMQ Execution Queue)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_EXPIRATION=7d

# -----------------------------------------------------------------------------
# Credential Vault Encryption (AES-256-GCM)
# Must be a 32-byte hex or base64 key
# -----------------------------------------------------------------------------
CREDENTIAL_ENCRYPTION_KEY=replace_with_a_32_byte_hex_or_base64_encryption_key
