{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA - Automate Beyond Limits. Visual workflow automation and orchestration SaaS",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:all": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@nexora/api",
    "dev:web": "npm run dev --workspace=@nexora/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "db:migrate": "npm run prisma:migrate --workspace=@nexora/api",
    "db:studio": "npm run prisma:studio --workspace=@nexora/api"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
